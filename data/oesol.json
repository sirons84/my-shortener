      { "label": "호", "value": "외솔. 홀로 선 소나무라는 뜻", "verified": true },
      { "label": "태어남", "value": "1894년 10월 19일, 울산군 내상면 동리 (지금의 울산 중구 동동)", "verified": true },
      { "label": "돌아가심", "value": "1970년 3월 23일", "verified": true },
      { "label": "배움", "value": "주시경 선생의 조선어강습원, 히로시마고등사범학교, 교토제국대학 철학과(교육학 전공)", "verified": true },
      { "label": "한 일", "value": "연희전문학교 교수, 조선어학회 활동, 한글맞춤법통일안 참여, 광복 뒤 문교부 편수국장, 한글학회 이사장", "verified": true },
      { "label": "대표 저서", "value": "『조선민족갱생의 도』(1930) 『우리말본』(1937) 『한글갈』(1942)", "verified": true },
      { "label": "기림", "value": "1962년 건국훈장 독립장", "verified": true }
